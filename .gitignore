# Nothing derived from the game is ever committed: its files, the code generated from default.xex, and the
# binaries built from that code.

# --- Game files ---------------------------------------------------------------
assets/
*.xex
*.xexp
*.iso
*.PAK
*.pak
*.bik
*.xma

# --- Generated from the game --------------------------------------------------
generated/
app*/generated/

# --- Build output -------------------------------------------------------------
out/
build/
*.nro
*.nacp
*.elf
*.o
*.obj
*.a
*.log
*.err

# --- Tools --------------------------------------------------------------------
__pycache__/
*.pyc
.vs/
.vscode/

# --- Local secrets ------------------------------------------------------------
analysis/

# --- Homebrew menu icons, cut from the dashboard art on the user's own disc (not distributed) ---
tools/switch/icon/*.jpg

# --- The published release (the workflow in .github publishes it) ------------------
!release/shh.nro
